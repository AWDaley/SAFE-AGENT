{
  "Proposal": {
    "$defs": {
      "CalendarCreateEvent": {
        "additionalProperties": false,
        "properties": {
          "calendar_ref": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "title": "Calendar Ref",
            "type": "string"
          },
          "customer_ref": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "title": "Customer Ref",
            "type": "string"
          },
          "end_at": {
            "format": "date-time",
            "title": "End At",
            "type": "string"
          },
          "operation": {
            "const": "calendar.create_event",
            "default": "calendar.create_event",
            "title": "Operation",
            "type": "string"
          },
          "projection_rev": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "title": "Projection Rev",
            "type": "string"
          },
          "schema_version": {
            "const": "safe_agent.proposal.v1",
            "default": "safe_agent.proposal.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "simulation_ref": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "title": "Simulation Ref",
            "type": "string"
          },
          "start_at": {
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          },
          "template_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "title": "Template Id",
            "type": "string"
          },
          "time_zone": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Time Zone",
            "type": "string"
          }
        },
        "required": [
          "calendar_ref",
          "customer_ref",
          "start_at",
          "end_at",
          "time_zone",
          "template_id",
          "simulation_ref",
          "projection_rev"
        ],
        "title": "CalendarCreateEvent",
        "type": "object"
      },
      "RequestClarification": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "agent.request_clarification",
            "default": "agent.request_clarification",
            "title": "Operation",
            "type": "string"
          },
          "question": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "NO_AVAILABLE_SLOT",
              "INSUFFICIENT_CONTEXT"
            ],
            "title": "Reason Code",
            "type": "string"
          },
          "schema_version": {
            "const": "safe_agent.proposal.v1",
            "default": "safe_agent.proposal.v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "reason_code",
          "question"
        ],
        "title": "RequestClarification",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "agent.request_clarification": "#/$defs/RequestClarification",
        "calendar.create_event": "#/$defs/CalendarCreateEvent"
      },
      "propertyName": "operation"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/CalendarCreateEvent"
      },
      {
        "$ref": "#/$defs/RequestClarification"
      }
    ]
  },
