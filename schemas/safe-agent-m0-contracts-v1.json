    "EvidenceEvent": {
      "additionalProperties": false,
      "description": "Opaque payload reference prevents model-visible logs from embedding customer data.",
      "properties": {
        "event_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_kind": {
          "enum": [
            "PROPOSED",
            "DENIED",
            "DISPATCHED",
            "VERIFIED",
            "OUTCOME_UNKNOWN"
          ],
          "title": "Event Kind",
          "type": "string"
        },
        "ledger_sequence": {
          "minimum": 1,
          "title": "Ledger Sequence",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "previous_event_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Event Hash"
        },
        "schema_version": {
          "const": "safe_agent.evidence.v1",
          "default": "safe_agent.evidence.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "task_id",
        "ledger_sequence",
        "event_kind",
        "occurred_at",
        "payload_digest"
      ],
      "title": "EvidenceEvent",
      "type": "object"
    },
