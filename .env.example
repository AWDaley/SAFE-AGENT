# No provider credentials are needed for M0. PostgreSQL is for a later milestone.
SAFE_AGENT_ENV=development
SAFE_AGENT_TAL_MODE=deny_all
SAFE_AGENT_DATABASE_URL=postgresql://safe_agent:local_development_only@localhost:5432/safe_agent

# M5: injected only into the trusted operator/credential service (leave blank here).
# No Google OAuth secrets or raw calendar IDs should be committed.
SAFE_AGENT_GOOGLE_CLIENT_ID=
SAFE_AGENT_GOOGLE_CLIENT_SECRET=
SAFE_AGENT_GOOGLE_TEST_CALENDAR_ID=
SAFE_AGENT_GOOGLE_OAUTH_REDIRECT_URI=
SAFE_AGENT_GOOGLE_FERNET_KEY=
